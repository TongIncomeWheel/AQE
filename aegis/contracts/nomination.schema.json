{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Voice Nomination File",
 "x_version": "1.0.0",
 "type": "object",
 "required": [
  "voice",
  "date",
  "nominations",
  "held_review"
 ],
 "properties": {
  "voice": {
   "type": "string"
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "universe_file": {
   "type": "string"
  },
  "nominations": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "ticker",
     "reason",
     "conviction"
    ],
    "properties": {
     "ticker": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "maxLength": 300
     },
     "fields_cited": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "conviction": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "price_at_nomination": {
      "type": [
       "number",
       "null"
      ],
      "description": "stamped by the ORCHESTRATOR from the universe file at tally (voices do not fetch prices)"
     }
    }
   },
   "x_note": "Fewer than 10 with shortfall_reason is a VALID outcome \u2014 never pad with low-conviction names (A-C2)"
  },
  "held_review": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ticker",
     "verdict"
    ],
    "properties": {
     "ticker": {
      "type": "string"
     },
     "verdict": {
      "enum": [
       "KEEP",
       "TIGHTEN",
       "EXIT-CASE"
      ]
     },
     "line": {
      "type": "string"
     }
    }
   }
  },
  "shortfall_reason": {
   "type": "string"
  }
 }
}