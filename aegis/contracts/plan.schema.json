{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Executive Action Plan", "x_version": "1.0.0",
  "type": "object", "required": ["date", "held_actions", "new_ideas", "watch_table", "approval"],
  "properties": {
    "date": {"type": "string", "format": "date"},
    "posture": {"type": "string"},
    "held_actions": {"type": "array", "items": {"type": "object",
      "required": ["ticker", "action"],
      "properties": {"ticker": {"type": "string"}, "action": {"enum": ["HOLD", "TRIM", "EXIT", "TIGHTEN_STOP", "SCALE_OUT"]},
        "stop_new": {"type": ["number", "null"], "description": "D-33: raised trailing stop (never below current) for TIGHTEN_STOP"},
        "tp_level": {"type": ["string", "null"], "description": "D-33: TP1/TP2/TP3 for SCALE_OUT"},
        "scale_shares": {"type": ["integer", "null"], "description": "D-33: shares to sell at this target for SCALE_OUT"},
        "exit_reason": {"enum": ["STOP", "TAKE_PROFIT", "ROTATION_THESIS", "ROTATION_CAPITAL", "STRUCTURE_EXIT", null], "description": "D-33: why an EXIT/TRIM"},
        "reason": {"type": "string"},
        "data_anchors": {"type": ["object", "null"], "description": "D-20: the numbers behind the action (unrealised, distance-to-stop, R-multiple, mp_state, etc.) so the PM sees why"}}}},
    "new_ideas": {"type": "array", "items": {"type": "object",
      "required": ["ticker", "tier", "nomination_count", "trigger", "bracket", "size_shares"],
      "properties": {"ticker": {"type": "string"}, "tier": {"type": "integer"},
        "nomination_count": {"type": "integer"}, "lens_tier": {"type": ["string", "null"]},
        "committee_position": {"enum": ["ADVANCE", "HOLD-FOR-CONDITIONS", "PASS", null]},
        "conviction": {"type": ["string", "null"]}, "dissent": {"type": ["string", "null"]},
        "trigger": {"type": "string"}, "bracket": {"type": "object"},
        "size_shares": {"type": ["integer", "null"]}, "size_r": {"type": ["number", "null"]},
        "preauthorised": {"type": "boolean", "default": false},
        "data_anchors": {"type": ["object", "null"], "description": "D-20 anti-black-box: the decisive field values behind this idea, from committee data_anchors — the PM's numeric anchor to decide on"},
        "lens_readings": {"type": ["object", "null"], "description": "D-20: when the Detect lens nominated or flagged this name, its ACTUAL readings (lens_positive, lens_warnings, runner_setup/conviction, premove_setup/conviction) shown explicitly — the lens never surfaces a name as a black box"}}}},
    "watch_table": {"type": "array", "items": {"type": "object"},
      "x_note": "D-20: each watch-table row must carry the data anchor that surfaced it (nomination_count, which voices, and the 2-3 field values behind it) — a watched name the PM can't see the data for is a black box"},
    "approval": {"type": "object", "properties": {"status": {"enum": ["DRAFT", "APPROVED", "EDITED", "REJECTED"]},
      "approved_at": {"type": ["string", "null"]}, "edits": {"type": "array", "items": {"type": "string"}}}}}}
