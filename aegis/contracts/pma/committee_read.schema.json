{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pma_committee_read",
  "description": "S6 output. One isolated committee-desk pass over the deliberation set. No sizes, no orders — conviction and family-fit are as far as this stage goes.",
  "x_version": "0.1",
  "type": "object",
  "required": ["artifact", "run_date", "generated_at", "verdicts"],
  "properties": {
    "artifact": {"const": "pma_committee_read"},
    "run_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string"},
    "deliberation_set_rule": {"type": "string"},
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "verdict", "conviction", "bear_case", "data_anchors", "challenge_response", "frame_consistency"],
        "properties": {
          "ticker": {"type": "string"},
          "verdict": {"enum": ["ADVANCE", "HOLD-FOR-CONDITIONS", "PASS"]},
          "conviction": {"type": "integer", "minimum": 1, "maximum": 5},
          "verdict_text": {"type": "string"},
          "bear_case": {"type": "string", "minLength": 1},
          "dissent": {"type": ["string", "null"]},
          "conditions": {"type": "array", "items": {"type": "string"}, "description": "For HOLD-FOR-CONDITIONS: what would promote it."},
          "data_anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["field", "value"],
              "properties": {
                "field": {"type": "string"},
                "value": {},
                "label": {"type": "string"}
              }
            }
          },
          "challenge_response": {"type": "string"},
          "frame_consistency": {
            "type": "object",
            "required": ["fits_crown_family", "fits_momentum_caveat"],
            "properties": {
              "fits_crown_family": {"type": ["boolean", "null"]},
              "fits_momentum_caveat": {"type": ["boolean", "null"]},
              "argued": {"type": ["string", "null"], "description": "A contradiction doesn't kill the idea — it must be ARGUED here."}
            }
          },
          "nominating_seats": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "shortfalls": {"type": "array", "items": {"type": "string"}}
  }
}
