{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pma_market_frame",
  "description": "S2 output. What kind of day is this — the GLOBAL blocks distilled. Every value carries its source path; a number without provenance does not enter the frame.",
  "x_version": "0.1",
  "type": "object",
  "required": ["artifact", "run_date", "generated_at", "staleness", "risk_tone", "momentum_caveat", "crown", "sectors", "cross_asset", "thematic", "declared_gaps"],
  "properties": {
    "artifact": {"const": "pma_market_frame"},
    "run_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string"},
    "staleness": {"$ref": "#/$defs/staleness"},
    "risk_tone": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": {"type": "string", "description": "Direct copy of regime.level, never recomputed. Observed vocabulary: GREEN/YELLOW/RED (the S2 card said AMBER — the export says YELLOW; the copy wins)."},
        "source": {"type": "string"}
      }
    },
    "momentum_caveat": {
      "type": "object",
      "required": ["text", "hurst", "trend", "implication", "sources"],
      "properties": {
        "text": {"type": "string"},
        "hurst": {"type": "number"},
        "trend": {"type": "string"},
        "implication": {"type": "string"},
        "vix": {"type": "number"},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "crown": {
      "type": "object",
      "required": ["present", "source"],
      "properties": {
        "present": {"type": "boolean"},
        "status": {"type": ["string", "null"]},
        "headline": {"type": ["string", "null"]},
        "family": {"type": ["string", "null"]},
        "match_quality": {"type": ["string", "null"]},
        "size_multiplier": {"type": ["number", "null"]},
        "conditions_met": {"type": "array", "items": {"type": "string"}},
        "conditions_not_met": {"type": "array", "items": {"type": "string"}},
        "key_levels_near": {"type": "array", "items": {"type": "object"}},
        "limits": {"type": "array", "items": {"type": "string"}},
        "oldest_source_days_behind": {"type": ["number", "null"]},
        "source": {"type": "string"}
      }
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["etf", "sector", "grade", "rrg_quadrant", "macro_headwind_flag", "entry_gate", "source"],
        "properties": {
          "etf": {"type": "string"},
          "sector": {"type": "string"},
          "grade": {"type": "string"},
          "rrg_quadrant": {"type": "string"},
          "rrg_direction": {"type": ["string", "null"]},
          "macro_headwind_flag": {"type": "string"},
          "entry_gate": {"type": "string"},
          "entry_gate_reason": {"type": ["string", "null"]},
          "source": {"type": "string"}
        }
      }
    },
    "cross_asset": {
      "type": "object",
      "required": ["dollar", "bonds", "credit", "breadth"],
      "additionalProperties": {"$ref": "#/$defs/one_liner"}
    },
    "thematic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["basket", "grade", "rrg_quadrant", "source"],
        "properties": {
          "basket": {"type": "string"},
          "grade": {"type": ["string", "null"]},
          "parent_gics": {"type": ["string", "null"]},
          "rrg_quadrant": {"type": ["string", "null"]},
          "roc20": {"type": ["number", "null"]},
          "source": {"type": "string"}
        }
      }
    },
    "summary_counts": {"type": "object"},
    "data_quality": {"type": "object"},
    "declared_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "staleness": {
      "type": "object",
      "required": ["export_date", "staleness_days", "pm_ack"],
      "properties": {
        "export_date": {"type": "string"},
        "staleness_days": {"type": "integer"},
        "pm_ack": {"type": ["string", "null"]}
      }
    },
    "one_liner": {
      "type": "object",
      "required": ["text", "values", "sources"],
      "properties": {
        "text": {"type": "string"},
        "values": {"type": "object"},
        "sources": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
