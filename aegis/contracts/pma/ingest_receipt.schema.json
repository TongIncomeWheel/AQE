{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pma_ingest_receipt",
  "description": "S1 output. Proves the day's inputs were found, validated and dated — or says exactly why the run must not proceed. A missing input is refused, not zeroed (Crown C30).",
  "x_version": "0.1",
  "type": "object",
  "required": ["artifact", "run_date", "generated_at", "files", "crown_absent", "proceed", "blocking_reason", "pm_ack", "notes"],
  "properties": {
    "artifact": {"const": "pma_ingest_receipt"},
    "run_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string"},
    "files": {
      "type": "object",
      "required": ["export", "crown"],
      "properties": {
        "export": {"$ref": "#/$defs/file_check"},
        "crown": {"$ref": "#/$defs/file_check"}
      }
    },
    "crown_absent": {"type": "boolean"},
    "proceed": {"type": "boolean"},
    "blocking_reason": {"type": ["string", "null"]},
    "pm_ack": {
      "type": ["string", "null"],
      "description": "Verbatim PM acknowledgement. REQUIRED (non-null) whenever the export is stale and proceed is true."
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Card-vs-reality mismatches and any adaptation made — design findings, never silent fixes."
    }
  },
  "$defs": {
    "file_check": {
      "type": "object",
      "required": ["found", "path", "generated_at", "staleness_days", "schema_valid", "degraded_flags"],
      "properties": {
        "found": {"type": "boolean"},
        "path": {"type": ["string", "null"]},
        "fetched_at": {"type": ["string", "null"]},
        "generated_at": {"type": ["string", "null"]},
        "staleness_days": {"type": ["integer", "null"]},
        "schema_valid": {"type": ["boolean", "null"]},
        "schema_errors": {"type": "array", "items": {"type": "string"}},
        "tripwire_result": {
          "type": ["object", "null"],
          "properties": {
            "exit_code": {"type": "integer"},
            "output": {"type": "string"}
          }
        },
        "status": {"type": ["string", "null"]},
        "oldest_source_days_behind": {"type": ["number", "null"]},
        "degraded_flags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
