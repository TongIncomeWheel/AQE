{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PMA S6 Pass B — bear brief (one per deliberation-set name, every tier)",
  "type": "object",
  "required": ["ticker", "run_date", "kill_thesis", "attacks", "unanswerable_gaps", "what_would_have_to_be_true"],
  "properties": {
    "ticker": {"type": "string"},
    "run_date": {"type": "string", "format": "date"},
    "tier": {"enum": ["FULL", "LEAN"]},
    "kill_thesis": {
      "type": "string",
      "description": "The case against. If nothing was found, must say so explicitly with what was looked for."
    },
    "found_nothing": {"type": "boolean"},
    "attacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "severity", "axis"],
        "properties": {
          "statement": {"type": "string"},
          "field": {"type": ["string", "null"]},
          "value": {},
          "severity": {"enum": ["fatal", "serious", "note"]},
          "axis": {"enum": ["crowding", "frame_contradiction", "data_hole", "timing", "falsifier", "other"]}
        }
      }
    },
    "unanswerable_gaps": {
      "type": "array",
      "description": "Decisive tests that could not be run because a field is NOT_SERVED",
      "items": {
        "type": "object",
        "required": ["test", "missing_field"],
        "properties": {"test": {"type": "string"}, "missing_field": {"type": "string"}}
      }
    },
    "what_would_have_to_be_true": {
      "type": "array",
      "description": "Conditions under which the bear withdraws",
      "items": {"type": "string"}
    }
  }
}
