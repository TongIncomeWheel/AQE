{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Committee rationale -- the Chair's verbatim-quoted draft / final (R42)",
 "x_version": "1.0.0",
 "x_purpose": "ONE rationale per AGREED/CONTESTED ticket made only of sourced verbatim clauses (vote, ratify, cross or tier2 forms). The Chair writes the DRAFT; the FINAL is written by code (pma_pipeline.py rationale-final): the draft plus every AMEND text attached verbatim as `also`. Minority notes are attached by code, not written here.",
 "type": "object",
 "required": [
  "date",
  "tickets"
 ],
 "properties": {
  "date": {
   "type": "string"
  },
  "tickets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ticker",
     "why"
    ],
    "properties": {
     "ticker": {
      "type": "string"
     },
     "why": {
      "type": "array",
      "maxItems": 6,
      "items": {
       "type": "object",
       "required": [
        "text",
        "source"
       ],
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 300,
         "x_note": "a verbatim quote of what a decider filed - the registrar re-checks it against the filed form"
        },
        "source": {
         "type": "object",
         "required": [
          "voice",
          "form",
          "field"
         ],
         "properties": {
          "voice": {
           "type": "string"
          },
          "form": {
           "type": "string"
          },
          "field": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "would_change": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "object",
       "required": [
        "text",
        "source"
       ],
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 300,
         "x_note": "a verbatim quote of what a decider filed - the registrar re-checks it against the filed form"
        },
        "source": {
         "type": "object",
         "required": [
          "voice",
          "form",
          "field"
         ],
         "properties": {
          "voice": {
           "type": "string"
          },
          "form": {
           "type": "string"
          },
          "field": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "also": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "voice",
        "text"
       ],
       "properties": {
        "voice": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       }
      },
      "x_note": "final stage only, written by CODE: every AMEND text verbatim"
     },
     "also_overflow": {
      "type": "array",
      "items": {
       "type": "object"
      },
      "x_note": "AMEND texts over the per-ticket byte cap; printed as minority notes"
     }
    }
   }
  }
 }
}