# ======================================================================
#  AEGIS RUNTIME — configuration.  Copy this file to ".env" and edit.
#  Nothing here is committed to git (.env is ignored). Keep it private.
# ======================================================================

# --- RUN MODE ---------------------------------------------------------
# 1 = FREE OFFLINE DEMO: the whole pipeline runs with canned data, no API,
#     no cost. Use this to confirm it works before spending anything.
# 0 = REAL: calls the Claude API. Requires ANTHROPIC_API_KEY below.
AEGIS_MOCK=1

# --- API KEYS (only needed when AEGIS_MOCK=0) -------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
# OPENAI_API_KEY=sk-...          # optional — only if you route a tier to OpenAI
# MOONSHOT_API_KEY=...           # optional — Kimi

# --- MODEL PER TIER ---------------------------------------------------
# Set these to the CURRENT model IDs (verify at docs.anthropic.com — IDs change).
# Format is LiteLLM's "provider/model". Voices = cheaper tier, committee = top tier.
AEGIS_MODEL_VOICES=anthropic/claude-sonnet-4-5
AEGIS_MODEL_COMMITTEE=anthropic/claude-opus-4-1
AEGIS_MODEL_CONTROL=anthropic/claude-haiku-4-5
