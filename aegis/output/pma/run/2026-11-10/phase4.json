  "SOLO": "nominated by 1 seat at conviction >=4 (a NOMINATED name; retained as a label only -- R16 made the second-door requirement moot)",
  "ELDER+LENS": "elder>=7 on each of last 2 bars AND >=3/6 lenses strong (FLAG ONLY -- R17: surfaces to the PM, never seats a name)",
  "LENS": ">=4/6 lenses strong (FLAG ONLY -- R17: surfaces to the PM, never seats a name)",
