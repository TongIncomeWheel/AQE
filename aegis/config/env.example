# Copy to .env on the PC. NEVER commit .env. One secret, one line, one place.
FMP_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
IBKR_ACCOUNT=
IBKR_GATEWAY=https://localhost:5000/v1/api
TIGER_MCP_URL=
GITHUB_PAT=   # D-48: REQUIRED for autonomous commit/push (tools/git_sync.py). Fine-grained PAT, Contents: Read+Write on TongIncomeWheel/AQE. No GitHub connector exists, so this token IS the push mechanism for unattended scheduled runs.
# --- Notifications (D-45): one-way phone alerts + external dead-man's-switch ---
WHATSAPP_TOKEN=          # Meta Cloud API bearer (or use TWILIO_* below instead)
WHATSAPP_PHONE_ID=       # Meta WhatsApp Business phone-number id
WHATSAPP_TO=             # your number in E.164, e.g. +65XXXXXXXX
TWILIO_SID=              # (alt provider) Twilio account SID
TWILIO_TOKEN=            # (alt) Twilio auth token
TWILIO_WHATSAPP_FROM=    # (alt) whatsapp:+1XXXXXXXXXX
WATCHDOG_URL=            # healthchecks.io (or similar) ping URL — ABSENCE of a check-in pages you
